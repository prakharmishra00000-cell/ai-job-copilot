# =====================================
# JobPilot AI - Environment Variables
# =====================================
# Copy this file to .env and fill in your values.
# Never commit the actual .env file to version control.

# ─── Database ────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ─── AI Provider ─────────────────────────────────────
# Supported: openai, gemini, anthropic, azure-openai
AI_PROVIDER=openai

# OpenAI API Key (if using OpenAI)
OPENAI_API_KEY=sk-...

# Google Gemini API Key (if using Gemini)
GOOGLE_AI_API_KEY=

# Anthropic API Key (if using Claude)
ANTHROPIC_API_KEY=

# ─── Application ─────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# App mode: development, production
NODE_ENV=development

# ─── Authentication ──────────────────────────────────
# Session encryption key (generate with: openssl rand -base64 32)
SESSION_SECRET=

# OAuth Providers (optional)
# Google OAuth (for Gmail integration)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (for profile import)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# LinkedIn OAuth (for profile import)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ─── Job Source APIs ─────────────────────────────────
# Most job platforms don't provide public APIs.
# These are placeholders for when official integrations become available.

# Indeed Publisher ID (if approved)
INDEED_PUBLISHER_ID=

# Adzuna API (alternative job source)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ─── Background Processing ───────────────────────────
# Redis URL for job queue (optional, for background workers)
REDIS_URL=

# Bull/BullMQ queue configuration
QUEUE_PREFIX=jobpilot

# ─── Notifications ───────────────────────────────────
# Email service (for notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@yourdomain.com

# Telegram Bot (optional)
TELEGRAM_BOT_TOKEN=

# ─── Security ────────────────────────────────────────
# Encryption key for sensitive data (generate with: openssl rand -base64 32)
ENCRYPTION_KEY=

# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# ─── Monitoring ──────────────────────────────────────
# Sentry DSN (error tracking)
SENTRY_DSN=

# Analytics (PostHog, Mixpanel, etc.)
ANALYTICS_KEY=

# =====================================
# Required for Production:
# 1. DATABASE_URL - PostgreSQL database
# 2. AI_PROVIDER + API key - For AI features
# 3. SESSION_SECRET - For authentication
# 4. ENCRYPTION_KEY - For data security
# 5. NEXT_PUBLIC_APP_URL - Your production URL
#
# Optional but Recommended:
# - SMTP credentials for email notifications
# - OAuth credentials for social login
# - Redis for background job processing
# =====================================
