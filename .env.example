# ==============================================
# JobPilot AI - Environment Variables
# ==============================================
#
# ZERO MANUAL SETUP REQUIRED!
# All job sources connect automatically.
#
# ==============================================

# Database (Auto-configured on Render)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ==============================================
# OPTIONAL: Google Gemini AI (FREE)
# Get key at: https://aistudio.google.com/apikey
# 
# Enables:
# - AI-powered cover letters
# - Smart job matching
# - Career recommendations
#
# App works perfectly WITHOUT this key!
# ==============================================
GOOGLE_AI_API_KEY=

# App URL (Auto-configured on Render)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Security (Auto-generated on Render)
SESSION_SECRET=
ENCRYPTION_KEY=

# ==============================================
# CONNECTED JOB SOURCES (No setup needed!)
# ==============================================
# ✅ RemoteOK - Remote tech jobs
# ✅ Jobicy - Remote jobs + salaries
# ✅ Himalayas - Curated positions
# ✅ Findwork - Developer jobs
# ✅ Arbeitnow - European jobs
# ✅ We Work Remotely - Remote jobs
# ✅ LinkedIn - Via aggregators
# ✅ India Jobs - Naukri region
# ✅ Internships Hub - Entry-level
# ==============================================
