# =====================================
# JobPilot AI - Environment Variables
# =====================================

# ─── Database ────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ─── AI Provider (Google Gemini) ─────────────────────
# Get FREE API key at: https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=

# ─── Application ─────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ─── Security ────────────────────────────────────────
SESSION_SECRET=
ENCRYPTION_KEY=

# ─── Optional: Additional Job Sources ────────────────
# Adzuna (free tier available): https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# =====================================
# ACTIVE JOB SOURCES (No API key needed!):
# ✅ RemoteOK - Remote tech jobs
# ✅ Arbeitnow - European jobs  
# ✅ Jobicy - Remote jobs with salaries
# ✅ Himalayas - Curated remote jobs
# ✅ Findwork.dev - Developer jobs
#
# These connect automatically on startup!
# =====================================
